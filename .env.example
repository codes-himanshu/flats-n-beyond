# MongoDB Atlas Connection URI
# Paste your personal MongoDB Atlas connection string below:
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<dbname>?retryWrites=true&w=majority
#
# Example:
# MONGODB_URI=mongodb+srv://admin:MySecurePass123@cluster0.abcde.mongodb.net/flatsnbeyond?retryWrites=true&w=majority
MONGODB_URI=

# Express API Server Port
PORT=5000
